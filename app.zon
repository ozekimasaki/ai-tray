.{
    .id = "dev.quotabar.app",
    .name = "quotabar",
    .display_name = "QuotaBar",
    .description = "Tray-resident AI usage monitor for Claude, Codex, Cursor, Antigravity, Gemini, OpenCode, and Alibaba.",
    .version = "0.1.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "windows", "linux" },
    .permissions = .{ "view", "command", "network", "filesystem", "credentials" },
    .capabilities = .{ "native_views", "gpu_surfaces", "tray", "persist", "credentials" },
    .persist = .{
        .version = 2,
        .restore = .{
            .ok = "restored",
            .none = "fresh_boot",
            .err = "restore_failed",
        },
    },
    .commands = .{
        .{ .id = "app.open", .title = "Open panel" },
        .{ .id = "app.dashboard", .title = "Open Dashboard" },
        .{ .id = "app.settings", .title = "Settings" },
        .{ .id = "app.refresh", .title = "Refresh" },
        .{ .id = "app.quit", .title = "Quit" },
        .{ .id = "app.dashboard-closed", .title = "Dashboard closed" },
        .{ .id = "app.settings-closed", .title = "Settings closed" },
    },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "QuotaBar",
                .width = 380,
                .height = 640,
                .min_width = 360,
                .min_height = 480,
                .resizable = false,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .titlebar = "chromeless",
                .transparent = true,
                .always_on_top = true,
                .click_through = false,
                .initially_hidden = false,
                .allows_fullscreen = false,
                .views = .{
                    .{
                        .label = "compact-canvas",
                        .kind = "gpu_surface",
                        .fill = true,
                        .role = "Quota compact panel",
                        .accessibility_label = "AI usage compact panel",
                        .gpu_backend = "software",
                        .gpu_pixel_format = "bgra8_unorm",
                        .gpu_present_mode = "timer",
                        .gpu_alpha_mode = "premultiplied",
                        .gpu_color_space = "srgb",
                        .gpu_vsync = true,
                    },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{
                "zero://app",
                "zero://inline",
                "https://api.anthropic.com",
                "https://claude.ai",
                "https://chatgpt.com",
                "https://cursor.com",
                "https://oauth2.googleapis.com",
                "https://cloudcode-pa.googleapis.com",
                "https://opencode.ai",
                "https://modelstudio.console.alibabacloud.com",
                "https://bailian.console.aliyun.com",
                "https://bailian-singapore-cs.alibabacloud.com",
                "https://bailian-cs.console.aliyun.com",
            },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
