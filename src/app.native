<!-- トレイ用コンパクト窓。外側パディングは透明、内側 surface が浮かぶカード。 -->
<!-- SDK のメイン窓は import の source set を渡さないため、テンプレートはここに置く。 -->
<template name="title-bar" args="heading">
  <row window-drag="true" gap="4" cross="center">
    <text grow="1"><span weight="medium">{heading}</span></text>
    <button size="sm" variant="ghost" icon="refresh-cw" on-press="refresh_requested" label="Refresh"></button>
    <button size="sm" variant="ghost" icon="panel-right" on-press="open_dashboard" label="Dashboard"></button>
    <button size="sm" variant="ghost" icon="settings" on-press="open_settings" label="Settings"></button>
    <button size="sm" variant="ghost" on-press="quit">Quit</button>
    <button size="sm" variant="ghost" icon="x" on-press="hide_compact" label="Close"></button>
  </row>
</template>
<template name="provider-card" args="slot">
  <column>
    <for each="visibleCards" key="id" as="c">
      <if test="{c.slot == slot}">
        <column background="surface_subtle" radius="lg" padding="10" gap="6">
          <row gap="8" cross="center">
            <text grow="1"><span weight="medium">{c.name}</span></text>
            <badge>{c.sourceBadge}</badge>
          </row>
          <text foreground="text_muted">{c.plan}</text>
          <if test="{c.status == 'loading'}">
            <text foreground="text_muted">Fetching...</text>
            <spinner/>
          </if>
          <if test="{c.status == 'missing'}">
            <text wrap="true" foreground="text_muted">{c.hint}</text>
          </if>
          <if test="{c.status == 'failed'}">
            <text foreground="destructive" wrap="true">{c.errorText}</text>
            <if test="{c.stale}">
              <text foreground="text_muted">Showing last values</text>
            </if>
          </if>
          <if test="{c.status == 'ready'}">
            <if test="{c.stale}">
              <badge>Stale</badge>
            </if>
            <for each="visibleBars" key="id" as="b">
              <if test="{b.slot == slot}">
                <column gap="2">
                  <row cross="center" gap="8">
                    <text grow="1">{b.title}</text>
                    <text>{b.leftLabel}</text>
                  </row>
                  <progress value="{b.usedFraction}" label="{b.title}"/>
                  <if test="{b.tone == 'destructive'}">
                    <text foreground="destructive">{b.resetLabel}</text>
                  </if>
                  <else>
                    <if test="{b.tone == 'warning'}">
                      <text foreground="warning">{b.resetLabel}</text>
                    </if>
                    <else>
                      <text foreground="text_muted">{b.resetLabel}</text>
                    </else>
                  </else>
                </column>
              </if>
            </for>
          </if>
          <if test="{c.status == 'idle'}">
            <text foreground="text_muted">Waiting for refresh</text>
          </if>
        </column>
      </if>
    </for>
  </column>
</template>
<column grow="1" padding="12" main="start">
  <column background="surface" radius="xl" padding="12" grow="1" gap="8">
    <use template="title-bar" heading="QuotaBar"/>
    <separator/>
    <text foreground="text_muted">{updatedLabel}</text>
    <if test="{demoMode}">
      <badge>Demo data</badge>
    </if>
    <scroll grow="1">
      <column gap="8">
        <for each="visibleCards" key="id" as="row">
          <use template="provider-card" slot="{row.slot}"/>
        </for>
        <else>
          <column gap="8" padding="16" main="center" cross="center">
            <text>No providers enabled</text>
            <text foreground="text_muted" wrap="true">Turn providers on in Settings, or keep Demo data to preview bars.</text>
            <button variant="primary" on-press="open_settings">Open Settings</button>
          </column>
        </else>
      </column>
    </scroll>
    <button variant="secondary" on-press="refresh_requested">Refresh now</button>
  </column>
</column>
